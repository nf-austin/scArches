manifest {
  name            = 'nf-austin/scArches'
  author          = 'Austin Varela'
  homePage        = 'https://github.com/nf-austin/scArches'
  description     = 'Automated scArches-based integration and label transfer.'
  mainScript      = 'main.nf'
  nextflowVersion = '>=24.04.0'
  version         = '1.0.0'
  defaultBranch   = 'main'
}

params {
  // Input / output -- provide EITHER --input or --h5ad_dir. Both name the QUERY
  // datasets; the reference atlas is --train_h5ad, a separate scalar param.
  // Samplesheet CSV with columns: sample, h5ad. This is the mode Seqera
  // Platform launches with (nextflow_schema.json gives it a file picker).
  input    = null
  h5ad_dir = null
  outdir   = "results"
  help     = false

  // Training options
  train_model = true
  model_type  = "SCANVI"  // SCVI,SCANVI,SCPOLI
  model_name  = "model"   // Must match between the run that trains the model and any later
                          // --train_model false run reusing "${outdir}/${model_name}.tar.gz"
  train_h5ad  = null      // Reference dataset to train on; required when --train_model true
  model_tarball = null    // Reuse a trained model archive; required when --train_model false.
                          // Defaults to "${outdir}/${model_name}.tar.gz", which only resolves
                          // when a previous run wrote there -- pass it explicitly on Platform.
  dataset_obs = ""        // obs column identifying batches/datasets; blank = treat as one batch
  celltype_obs = "cell_type"  // obs column with reference cell type labels

  n_hvgs               = 6000  // number of highly variable genes used for training
  train_max_epochs     = 200   // max epochs for TRAIN_MODEL
  finetune_epochs      = 20    // SCANVI fine-tuning epochs after the SCVI pretraining stage
  integrate_max_epochs = 100   // max epochs for APPLY_MODEL's query mapping

  // Fraction of the --dataset_obs levels a gene must be detected in to survive into training. A
  // reference stitched together from several sub-atlases by an outer join keeps genes present in
  // only some sources and zero-fills them in the rest; the model then learns those structural
  // zeros as near-perfect sub-atlas discriminators, and a query with a complete panel maps to
  // whichever sub-atlas "has" them rather than to its own tissue. Genuinely tissue-restricted
  // genes survive the filter because ambient RNA puts them at some low level in every dataset --
  // only never-measured genes are exactly zero.
  //
  // A fraction rather than a count so it scales with however many datasets the reference has: the
  // requirement can never exceed the levels that exist, and a single-dataset reference resolves to
  // 1. The default of 1.0 requires every dataset, i.e. the exact intersection of their panels;
  // lower it only if you know a specific source is missing genes you want to keep. 0 disables, as
  // does leaving --dataset_obs blank (nothing to compare across).
  min_dataset_detection = 1.0

  // Fraction of the reference model's gene panel that must be present in a query file before
  // APPLY_MODEL will map it. scArches' surgery silently zero-fills every missing gene, and that
  // padding hits low-UMI cell types (T/NK cells) hardest, so a poor overlap shows up as
  // confident-but-wrong label transfer rather than as an error. 0 disables the check.
  min_gene_overlap = 0.9

  // Label-prior balancing. An unbalanced reference makes both label-transfer paths favour its
  // largest classes: SCANVI's classification head trains on the raw label distribution, and the
  // weighted-KNN scores each label by its share of a query cell's neighbours.
  n_samples_per_label = 100    // SCANVI fine-tuning: cells sampled per label per epoch (0 = off)
  max_cells_per_label = 50000  // cap on reference cells per label when fitting the weighted-KNN
                               // classifier (0 = use every cell). Also bounds that classifier's
                               // index, which is brute-force and scans all of it per query cell.

  // Model architecture, used by TRAIN_MODEL's encoder/decoder. SCVI/SCANVI take these directly
  // (n_layers, dropout_rate); scPoli maps them onto its own hidden_layer_sizes/dr_rate args
  // (see modules/models/train.py).
  n_layers      = 3      // number of hidden layers in the encoder/decoder
  dropout_rate  = 0.2    // dropout rate applied in the encoder/decoder
  learning_rate = 0.001  // optimizer learning rate for all TRAIN_MODEL training stages

  // Minibatch size passed to scvi-tools/scArches' `model.train(batch_size=...)`. Larger values
  // trade gradient noise for throughput: fewer, larger steps per epoch, which trains faster on a
  // GPU with enough VRAM but can hurt convergence if pushed too high. Raise
  // TRAIN_MODEL/APPLY_MODEL's `memory` in the process block below if you increase these and hit
  // OOM errors.
  batch_size = 1024           // TRAIN_MODEL, over the whole reference

  // APPLY_MODEL's batch size is deliberately separate and small. A query file holds one sample,
  // so steps-per-epoch is ceil(0.9 * n_cells / batch_size) - single digits once the batch size
  // approaches the sample size. Reusing a reference-scale batch size here leaves the surgery only
  // a few hundred gradient steps to fit the query's new batch embedding from scratch, so it stays
  // near its initialization and the query lands wherever the frozen encoder puts it, uncorrected.
  integrate_batch_size = 128  // APPLY_MODEL, per query sample

  use_gpu = false  // train/apply on GPU instead of CPU; requires a CUDA-capable executor/container runtime
  use_knn = false  // transfer labels with the weighted-KNN classifier instead of the model's native
                   // one (SCANVI/scPoli); SCVI has no native classifier and always uses the KNN
  knn_neighbors = 50  // neighbors for the weighted-KNN classifier TRAIN_MODEL fits on the reference latents

  // Container image, published to GHCR by .github/workflows/docker.yml. Pinned
  // rather than :latest so runs stay reproducible; bump alongside
  // manifest.version. One image serves every process -- the scArches stack is a
  // superset of what the other steps need. A custom image rather than a public
  // biocontainer because scArches installs from a git ref.
  scarches_container     = "ghcr.io/nf-austin/scarches:1.0.0"
  scarches_container_gpu = "ghcr.io/nf-austin/scarches:1.0.0-cuda"
  scarches_container_any = null   // set to override both

  // Resource caps
  max_memory = 128.GB
  max_cpus   = 32
  max_time   = 72.h

  // Execution environment. Used by the `slurm` profile; ignored otherwise.
  // Seqera Platform's own SLURM compute environment sets the executor itself,
  // so the profile is mainly for launching by hand from a login node.
  slurm_queue     = null   // sbatch --partition
  slurm_account   = null   // sbatch --account
  cluster_options = null   // raw sbatch options, e.g. '--qos=long'

  // SLURM ignores the `accelerator` directive -- verified on 26.04: cpus and
  // memory translate to -c/--mem, but no --gres line is emitted. So on SLURM the
  // GPU request has to travel through clusterOptions instead.
  gpu_cluster_options = '--gres=gpu:1'

  // Caches. Left null so NXF_SINGULARITY_CACHEDIR / NXF_CONDA_CACHEDIR or an
  // explicit flag wins, and Nextflow's own $NXF_HOME default applies otherwise.
  // Point these at shared storage on a cluster: $HOME is quota-limited and not
  // always mounted on compute nodes. Never at ${projectDir} -- on a Platform
  // launch that is a fresh scratch clone per run, so nothing would ever cache.
  singularity_cache_dir = null
  conda_cache_dir       = null

  // Extra Singularity bind mounts. autoMounts only binds paths Nextflow has
  // resolved, and HPC filesystems are routinely symlinked (/data -> /mnt/gpfs/..),
  // which surfaces as "file not found" inside the container despite the host
  // path existing. Comma-separated, e.g. '/mnt/gpfs,/scratch'.
  singularity_bind = null
}

process {
  resourceLimits = [
    memory: params.max_memory,
    cpus  : params.max_cpus,
    time  : params.max_time
  ]

  // Every process runs in the scArches image. The CPU/CUDA choice follows
  // --use_gpu unless an image is pinned explicitly.
  container = { params.scarches_container_any ?: (params.use_gpu ? params.scarches_container_gpu : params.scarches_container) }

  withName: 'TRAIN_MODEL' {
    cpus          = { workflow.stubRun ? 1    : 16 * task.attempt }
    memory        = { workflow.stubRun ? 1.GB : 64.GB * task.attempt }
    time          = { workflow.stubRun ? 10.m : 24.h * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
    // Honored by Docker/Kubernetes/cloud batch executors. SLURM ignores it --
    // verified on 26.04 -- hence the clusterOptions below. `null` rather than
    // `0`: requesting zero accelerators is not the same as not requesting one.
    accelerator   = { params.use_gpu ? 1 : null }
    // A withName clusterOptions SHADOWS the slurm profile's, so re-compose both
    // rather than overwriting -- otherwise a user's --cluster_options is
    // silently dropped on exactly the processes that need a GPU.
    clusterOptions = {
      [params.cluster_options, params.use_gpu ? params.gpu_cluster_options : null]
        .findAll().join(' ') ?: null
    }
  }

  withName: 'APPLY_MODEL' {
    cpus          = { workflow.stubRun ? 1    : 8 * task.attempt }
    memory        = { workflow.stubRun ? 1.GB : 32.GB * task.attempt }
    time          = { workflow.stubRun ? 10.m : 6.h * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
    accelerator   = { params.use_gpu ? 1 : null }
    clusterOptions = {
      [params.cluster_options, params.use_gpu ? params.gpu_cluster_options : null]
        .findAll().join(' ') ?: null
    }
  }

  withName: 'MAKE_REPORT|CONCAT_H5ADS|COMPRESS|DECOMPRESS' {
    cpus          = { workflow.stubRun ? 1    : 4 * task.attempt }
    memory        = { workflow.stubRun ? 1.GB : 16.GB * task.attempt }
    time          = { workflow.stubRun ? 10.m : 2.h * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
  }
}

// Execution reports. Seqera Platform renders these, and they are the first
// thing to look at when a run misbehaves. overwrite so -resume does not fail on
// a pre-existing file.
report {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
trace {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

profiles {
  // Executor only -- deliberately touches no container-engine setting, so its
  // key set stays disjoint from the engine profiles below and
  // `-profile slurm,singularity` composes in either order.
  // A null queue/clusterOptions emits no sbatch flag at all (verified on 26.04),
  // so these are safe to assign unconditionally -- which matters, because
  // `nextflow lint` rejects an `if` statement inside a config block.
  slurm {
    process.executor       = 'slurm'
    process.queue          = params.slurm_queue
    process.clusterOptions = params.cluster_options
  }
  docker {
    docker.enabled      = true
    // userEmulation was removed in Nextflow 24.x; fixOwnership replaces it.
    docker.fixOwnership = true
    docker.runOptions   = params.use_gpu ? '--gpus all' : null
    singularity.enabled = false
    conda.enabled       = false
  }
  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    singularity.cacheDir   = params.singularity_cache_dir
    // GPU passthrough and bind mounts are COMBINED, not overwritten: assigning
    // one would silently drop the other, and --nv missing turns a GPU run into
    // a slow CPU run with no error.
    singularity.runOptions = [
      params.use_gpu ? '--nv' : null,
      params.singularity_bind ? "-B ${params.singularity_bind}" : null
    ].findAll().join(' ') ?: null
    docker.enabled         = false
    conda.enabled          = false
  }
  conda {
    // Every module ships an environment.yml as well as a container, so
    // conda-only mode is a real fallback here.
    conda.enabled       = true
    conda.cacheDir      = params.conda_cache_dir
    docker.enabled      = false
    singularity.enabled = false
  }
}
